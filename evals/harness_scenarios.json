{
 "_comment": "Contrato entre check_run.py e a CLI do harness. Nomes e flags conferidos contra references/harness.md §3 e o código (scripts/harness/engine/state.py, router.py, session.py, scripts/memory/mem.py, scripts/stage/cli.py) em 2026-10-02. Cada cenário roda numa CÓPIA temporária do alvo. Se a CLI mudar de nome/flags, ajuste AQUI (não no check_run.py). Placeholders: {T} alvo (cópia), {SKILL} raiz da skill, {AGENT_DEV}/{AGENT_DEV2} donos de scenario_paths.dev_a/dev_b, {AGENT_GATE} primeiro agente gate, {AGENT_LESSON} dono de scenario_paths.lesson_file, {PATH_*} = scenario_paths.* do GROUND_TRUTH, {TEST_CMD} = comando de teste do GROUND_TRUTH, {i} = índice em repeat. Tipos de passo: tool | hook | write | git_commit | assert_file | assert_jsonl | repeat | save_stdout/compare. Atenção: argparse sai com exit 2 em flag errada — todo passo expect=fail leva stdout_any com a mensagem de recusa esperada, para não passar por erro de uso. cs-state escreve no board com campo `state` (não `status`); cs-route e cs-state não têm saída JSON (j5/texto): asserções por texto.",
 "tools": {
  "cs": [
   [
    "python3",
    "{SKILL}/scripts/cs.py",
    "--target",
    "{T}"
   ]
  ],
  "state": [
   [
    "{T}/.swarm/bin/cs-state"
   ],
   [
    "python3",
    "{T}/.swarm/harness/state.py",
    "--root",
    "{T}"
   ],
   [
    "python3",
    "{SKILL}/scripts/harness/engine/state.py",
    "--root",
    "{T}"
   ]
  ],
  "session": [
   [
    "{T}/.swarm/bin/cs-session"
   ],
   [
    "python3",
    "{T}/.swarm/harness/session.py",
    "--root",
    "{T}"
   ],
   [
    "python3",
    "{SKILL}/scripts/harness/engine/session.py",
    "--root",
    "{T}"
   ]
  ],
  "mem": [
   [
    "{T}/.swarm/bin/cs-mem"
   ],
   [
    "python3",
    "{T}/.swarm/harness/mem.py",
    "--root",
    "{T}"
   ],
   [
    "python3",
    "{SKILL}/scripts/memory/mem.py",
    "--root",
    "{T}"
   ]
  ],
  "route": [
   [
    "{T}/.swarm/bin/cs-route"
   ],
   [
    "python3",
    "{T}/.swarm/harness/router.py",
    "--root",
    "{T}"
   ],
   [
    "python3",
    "{SKILL}/scripts/harness/engine/router.py",
    "--root",
    "{T}"
   ]
  ],
  "stage": [
   [
    "python3",
    "{SKILL}/scripts/cs.py",
    "--target",
    "{T}",
    "stage"
   ]
  ],
  "validate": [
   [
    "python3",
    "{SKILL}/scripts/cs.py",
    "--target",
    "{T}",
    "harness",
    "validate",
    "--strict"
   ],
   [
    "python3",
    "{SKILL}/scripts/harness/engine/validate.py",
    "--root",
    "{T}",
    "--strict"
   ]
  ],
  "selftest": [
   [
    "python3",
    "{SKILL}/scripts/cs.py",
    "--target",
    "{T}",
    "harness",
    "selftest"
   ],
   [
    "python3",
    "{SKILL}/scripts/harness/engine/selftest.py",
    "--root",
    "{T}"
   ]
  ]
 },
 "scenarios": [
  {
   "id": "G9.session-roundtrip",
   "gate": "G9",
   "modes": [
    "setup"
   ],
   "text": "[G9] cs-session: save grava resume.json5; load com carimbo batendo imprime <=2.000 tokens e é idempotente; após commit novo, load mostra o delta",
   "steps": [
    {
     "tool": "session",
     "args": [
      "save",
      "--did",
      "eval: montou o time",
      "--next",
      "eval: rodar sonda"
     ],
     "expect": "ok"
    },
    {
     "assert_file": {
      "path": ".swarm/session/resume.json5",
      "json5": true
     }
    },
    {
     "tool": "session",
     "args": [
      "load"
     ],
     "expect": "ok",
     "max_tokens": 2000,
     "save_stdout": "L1"
    },
    {
     "tool": "session",
     "args": [
      "load"
     ],
     "expect": "ok",
     "save_stdout": "L2"
    },
    {
     "compare": [
      "L1",
      "L2"
     ],
     "op": "eq"
    },
    {
     "write": {
      "path": "{PATH_TRIVIAL}",
      "append": "\n<!-- eval: commit novo -->\n"
     }
    },
    {
     "git_commit": "docs: eval delta marker"
    },
    {
     "tool": "session",
     "args": [
      "load"
     ],
     "expect": "ok",
     "max_tokens": 2000,
     "stdout_any": [
      "eval delta marker",
      "delta",
      "Delta",
      "novo"
     ],
     "stdout_differs_from": "L1"
    }
   ]
  },
