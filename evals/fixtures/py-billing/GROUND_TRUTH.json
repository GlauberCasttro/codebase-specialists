 "business_rules": [
  {
   "id": "money-int-only",
   "rule": "Money.cents precisa ser int (float e bool são rejeitados).",
   "at": {
    "file": "src/billing/shared/money.py",
    "line": 36,
    "match": "must be int"
   },
   "test": "tests/test_money.py::MoneyTest::test_rejects_float",
   "keywords_any": [
    "float",
    "int"
   ],
   "owner_prefixes": [
    "src/billing/shared/"
   ],
   "mem_query": "Money cents must be int float rejected"
  },
  {
   "id": "invoice-transitions",
   "rule": "Fatura: DRAFT -> ISSUED -> PAID | VOID; PAID e VOID são terminais; fatura paga nunca é anulada (vai por reembolso).",
   "at": {
    "file": "src/billing/invoices/models.py",
    "line": 21,
    "match": "ALLOWED_TRANSITIONS: Dict"
   },
   "test": "tests/test_invoices.py::InvoiceLifecycleTest::test_paid_invoice_cannot_be_voided",
   "keywords_any": [
    "DRAFT",
    "ISSUED",
    "PAID",
    "VOID",
    "transi"
   ],
   "owner_prefixes": [
    "src/billing/invoices/"
   ],
   "mem_query": "invoice transition DRAFT ISSUED PAID VOID terminal"
  },
  {
   "id": "invoice-number-on-issue",
   "rule": "Número da fatura (INV-<ano>-<seq 6 dígitos>) só é atribuído no issue; sequência reinicia a cada ano.",
   "at": {
    "file": "src/billing/invoices/numbering.py",
    "line": 16,
    "match": "INV-%d-%06d"
   },
   "test": "tests/test_invoices.py::InvoiceLifecycleTest::test_number_assigned_only_on_issue",
   "keywords_any": [
    "INV-",
    "issue",
    "numera"
   ],
   "owner_prefixes": [
    "src/billing/invoices/"
   ],
   "mem_query": "invoice number assigned on issue yearly sequence"
  },
  {
   "id": "refund-limit",
   "rule": "Soma dos reembolsos nunca excede o valor capturado (RefundExceedsCapture).",
   "at": {
    "file": "src/billing/payments/refunds.py",
    "line": 9,
    "match": "def check_refund"
   },
   "test": "tests/test_payments.py::PaymentServiceTest::test_partial_refunds_cannot_exceed_capture",
   "keywords_any": [
    "refund",
    "reembolso"
   ],
   "owner_prefixes": [
    "src/billing/payments/"
   ],
   "mem_query": "refund cannot exceed captured amount"
  },
  {
   "id": "capture-idempotent",
   "rule": "capture com idempotency_key repetida devolve o mesmo Payment sem chamar o gateway nem lançar no ledger.",
   "at": {
    "file": "src/billing/payments/service.py",
    "line": 44,
    "match": "if idempotency_key in self._by_key:"
   },
   "test": "tests/test_payments.py::PaymentServiceTest::test_capture_is_idempotent",
   "keywords_any": [
    "idempot"
   ],
   "owner_prefixes": [
    "src/billing/payments/"
   ],
   "mem_query": "capture idempotency key repeated"
  },
  {
   "id": "entry-balanced",
   "rule": "Todo LedgerEntry é balanceado: soma de débitos == soma de créditos (LedgerImbalance).",
   "at": {
    "file": "src/billing/ledger/journal.py",
    "line": 53,
