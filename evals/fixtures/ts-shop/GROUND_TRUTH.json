{
 "description": "Monorepo npm workspaces: packages/shared (contratos), packages/api (express: catalog, inventory, orders), apps/web (React+Vite); node:test com type stripping.",
 "product_dirs": [
  "packages/shared/src",
  "packages/api/src",
  "packages/api/src/inventory",
  "packages/api/src/orders",
  "packages/api/src/catalog",
  "packages/api/src/http",
  "apps/web/src",
  "apps/web/src/cart",
  "docs/adr",
  ".github/workflows"
 ],
 "fixture_paths": [
  "packages/api/test/fixtures/"
 ],
 "bounded_contexts": [
  {
   "name": "shared-contracts",
   "prefixes": [
    "packages/shared/"
   ],
   "aliases": [
    "shared",
    "contracts",
    "contratos"
   ]
  },
  {
   "name": "api",
   "prefixes": [
    "packages/api/src/"
   ],
   "aliases": [
    "api",
    "inventory",
    "orders",
    "checkout",
    "estoque"
   ]
  },
  {
   "name": "web",
   "prefixes": [
    "apps/web/"
   ],
   "aliases": [
    "web",
    "storefront",
    "frontend",
    "front"
   ]
  }
 ],
 "acceptable_extra_territories": [
  {
   "name": "docs",
   "prefixes": [
    "docs/",
    "README.md",
    "AGENTS.md"
   ]
  },
  {
   "name": "build-ci",
   "prefixes": [
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "tsconfig.base.json",
    "eslint.config.mjs",
    ".github/",
    ".nvmrc",
    ".gitignore"
   ]
  },
  {
   "name": "api-tests",
   "prefixes": [
    "packages/api/test/"
   ]
  }
 ],
 "commands": {
  "test": {
   "cmd": "npm test",
   "equivalents": [
    "npm run test --workspaces",
    "node --test",
    "npm run test"
   ],
   "requires_tools": [
    "npm",
    "node"
   ],
   "expected": "verified"
  },
  "lint": {
   "cmd": "npm run lint",
   "equivalents": [
    "eslint ."
   ],
   "requires_tools": [
    "node_modules/.bin/eslint"
   ],
   "expected": "verified_if_tools"
  },
  "typecheck": {
   "cmd": "npm run typecheck",
   "equivalents": [
    "tsc -b"
   ],
   "requires_tools": [
    "node_modules/.bin/tsc"
   ],
   "expected": "verified_if_tools"
  }
 },
 "invariants": [
  {
   "id": "stock-never-negative",
   "adr": "docs/adr/0002-stock-reservations.md",
   "statement": "available de um SKU nunca fica negativo; take checa antes de mutar.",
   "keywords_all": [
    [
     "negativ",
     "negative"
    ],
    [
     "stock",
     "estoque"
    ]
   ],
   "owner_prefixes": [
    "packages/api/src/inventory/"
   ]
  },
  {
   "id": "web-no-api-import",
   "adr": "docs/adr/0001-web-talks-to-api-over-http.md",
   "statement": "apps/web nunca importa @shop/api; contratos em @shop/shared (lint).",
   "keywords_all": [
    [
     "@shop/api"
    ],
    [
     "@shop/shared",
     "http"
    ]
   ],
   "owner_prefixes": [
    "apps/web/"
   ]
  },
  {
   "id": "erasable-ts-only",
   "adr": null,
   "statement": "Só sintaxe TS apagável (sem enum/namespace/parameter properties): node roda .ts com type stripping.",
   "keywords_all": [
    [
     "enum"
    ],
    [
     "strip",
     "erasable",
     "apag"
    ]
   ],
   "owner_prefixes": [
    "packages/"
   ]
  }
 ],
 "terms": [
  {
   "canonical": "Sku",
   "kind": "business",
   "def": {
    "file": "packages/shared/src/sku.ts",
    "line": 2,
