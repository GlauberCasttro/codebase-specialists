   ],
   "mem_query": "Sku format AAA-0000"
  },
  {
   "canonical": "Cart",
   "kind": "business",
   "def": {
    "file": "packages/shared/src/cart.ts",
    "line": 10,
    "match": "export interface Cart {"
   },
   "never_use": [],
   "owner_prefixes": [
    "packages/shared/",
    "apps/web/"
   ],
   "mem_query": "Cart lines unitPriceCents"
  },
  {
   "canonical": "Order",
   "kind": "business",
   "def": {
