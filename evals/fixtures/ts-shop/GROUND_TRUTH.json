    "line": 9,
    "match": "export interface Order"
   },
   "never_use": [],
   "owner_prefixes": [
    "packages/shared/",
    "packages/api/src/orders/"
   ],
   "mem_query": "Order status totalCents"
  },
  {
   "canonical": "Reservation",
   "kind": "business",
