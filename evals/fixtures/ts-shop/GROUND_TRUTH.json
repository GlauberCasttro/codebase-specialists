    "line": 7,
    "match": "export interface Reservation"
   },
   "never_use": [
    "hold",
    "holdStock"
   ],
   "owner_prefixes": [
    "packages/api/src/inventory/"
   ],
   "mem_query": "Reservation expires TTL"
  },
  {
   "canonical": "priceCents",
   "kind": "business",
   "def": {
    "file": "packages/api/src/catalog/catalog.ts",
    "line": 6,
    "match": "priceCents: number"
   },
   "never_use": [
    "preco"
   ],
   "owner_prefixes": [
    "packages/api/src/catalog/"
   ],
   "mem_query": "priceCents integer"
  }
 ],
 "business_rules": [
  {
   "id": "stock-non-negative",
   "rule": "Estoque disponível nunca fica negativo: take lança InsufficientStockError antes de mutar.",
   "at": {
    "file": "packages/api/src/inventory/stock.ts",
    "line": 34,
    "match": "if (quantity > current)"
   },
   "test": "packages/api/src/inventory/stock.test.ts::stock never goes negative",
   "keywords_any": [
    "negativ",
    "InsufficientStock"
   ],
   "owner_prefixes": [
    "packages/api/src/inventory/"
   ],
   "mem_query": "stock never negative insufficient"
  },
  {
   "id": "reservation-ttl",
   "rule": "Reserva expira em 15 minutos e devolve o estoque.",
   "at": {
    "file": "packages/api/src/inventory/reservations.ts",
    "line": 5,
    "match": "RESERVATION_TTL_MS = 15"
   },
   "test": "packages/api/src/inventory/stock.test.ts::reservation expires after 15 minutes",
   "keywords_any": [
    "15 min",
    "15-minute",
    "TTL",
    "RESERVATION_TTL_MS"
   ],
   "owner_prefixes": [
    "packages/api/src/inventory/"
   ],
   "mem_query": "reservation expires 15 minutes"
  },
  {
   "id": "qty-per-line",
   "rule": "Quantidade por linha do carrinho: inteiro 1..10 (MAX_QTY_PER_LINE).",
   "at": {
    "file": "packages/api/src/orders/rules.ts",
    "line": 2,
    "match": "MAX_QTY_PER_LINE = 10"
   },
   "test": "packages/api/src/orders/checkout.test.ts::quantity per line is limited to 10",
   "keywords_any": [
    "MAX_QTY_PER_LINE",
    "1..10",
    "10"
   ],
   "owner_prefixes": [
    "packages/api/src/orders/"
   ],
   "mem_query": "quantity per line max 10"
  },
  {
   "id": "order-transitions",
   "rule": "Pedido: pending -> paid -> shipped; pending|paid -> cancelled; shipped/cancelled terminais.",
   "at": {
    "file": "packages/api/src/orders/status.ts",
    "line": 4,
    "match": "export const ORDER_TRANSITIONS"
   },
   "test": "packages/api/src/orders/checkout.test.ts::shipped orders cannot be cancelled",
   "keywords_any": [
    "shipped",
    "cancel",
    "transi"
   ],
   "owner_prefixes": [
    "packages/api/src/orders/"
   ],
   "mem_query": "order transition shipped cancelled"
  },
  {
   "id": "checkout-all-or-nothing",
   "rule": "Checkout reserva todas as linhas ou nenhuma (libera o que reservou se uma falha).",
   "at": {
    "file": "packages/api/src/orders/checkout.ts",
    "line": 19,
    "match": "reservationIds.forEach((id) => book.release(id));"
   },
   "test": "packages/api/src/orders/checkout.test.ts::checkout is all-or-nothing",
   "keywords_any": [
    "all-or-nothing",
    "tudo ou nada",
    "release"
   ],
   "owner_prefixes": [
    "packages/api/src/orders/"
   ],
   "mem_query": "checkout all or nothing release reservations"
  },
  {
   "id": "sku-format",
   "rule": "SKU = três letras maiúsculas, hífen, quatro dígitos (AAA-0000).",
   "at": {
    "file": "packages/shared/src/sku.ts",
    "line": 4,
    "match": "SKU_PATTERN ="
   },
   "test": "packages/shared/src/sku.test.ts::parseSku normalizes",
   "keywords_any": [
    "AAA-0000",
    "SKU_PATTERN"
   ],
   "owner_prefixes": [
    "packages/shared/"
   ],
   "mem_query": "SKU format pattern"
  }
 ],
